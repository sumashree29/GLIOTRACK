# ─────────────────────────────────────────────────────────────────────────────
# CBTA Frontend — Environment variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# URL of your deployed Render FastAPI backend.
# All API calls go directly here — no Next.js proxy.
# Include the protocol, no trailing slash.
# Example: https://cbta-api.onrender.com
NEXT_PUBLIC_API_BASE=https://your-render-app.onrender.com

# Upload freeze flag — mirrors UPLOADS_PAUSED on the Render backend.
# Set to "true" on Vercel to show the maintenance banner on the upload page
# before the user even submits. Remove or set to "false" to re-enable uploads.
# The backend 503 gate is authoritative; this is a UX improvement only.
NEXT_PUBLIC_UPLOADS_PAUSED=false
